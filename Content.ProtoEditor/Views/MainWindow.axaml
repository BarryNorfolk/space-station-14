<Window
    x:Class="Content.ProtoEditor.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Content.ProtoEditor.Views"
    xmlns:vm="using:Content.ProtoEditor.ViewModels"
    Title="Content.ProtoEditor"
    d:DesignHeight="500"
    d:DesignWidth="1000"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">

    <DockPanel LastChildFill="True">
        <Border
            x:Name="Footer"
            Height="30"
            BorderBrush="LightGray"
            BorderThickness="0 1 0 0"
            DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding State}" />
        </Border>
        <views:PrototypeListView
            BorderBrush="LightGray"
            BorderThickness="0 0 1 0"
            DockPanel.Dock="Left" Width="400" />
        <Grid ColumnDefinitions="600, *">
            <views:PrototypePropertyView BorderBrush="DarkGray" BorderThickness="0 0 1 0" />
            <TextBlock Grid.Column="1"
                       Text="Detail View"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </DockPanel>
</Window>
