<Window
    x:Class="Content.ProtoEditor.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Content.ProtoEditor.Views"
    xmlns:vm="using:Content.ProtoEditor.ViewModels"
    Title="Content.ProtoEditor"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">

    <DockPanel LastChildFill="True">
        <Border
            x:Name="footer"
            Height="30"
            BorderBrush="Black"
            BorderThickness="1"
            DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding State}" />
        </Border>
        <views:PrototypeListView DockPanel.Dock="Left" />
        <views:PrototypeComponentView />
    </DockPanel>
</Window>
