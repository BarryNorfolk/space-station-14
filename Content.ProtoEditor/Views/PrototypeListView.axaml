<UserControl
    x:Class="Content.ProtoEditor.Views.PrototypeListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Content.ProtoEditor.ViewModels"
    x:DataType="vm:PrototypeListViewModel"
    Design.Width="400"
    Design.Height="500">

    <Grid RowDefinitions="50,*">
        <Grid Grid.Row="0" ColumnDefinitions="*, *"
              Margin="5,00">
            <TextBox
                Grid.Column="0"
                Margin="5 0"
                Height="30"
                HorizontalContentAlignment="Center"
                Text="{Binding ListFilterText, UpdateSourceTrigger=PropertyChanged}"
                Watermark="Filter..." />
            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                DisplayMemberBinding="{Binding ShortName}"
                ItemsSource="{Binding Kinds}"
                SelectedItem="{Binding ListFilterKind, Mode=TwoWay}" />
        </Grid>
        <ListBox
            Grid.Row="1"
            ItemsSource="{Binding PrototypeViewModels}"
            SelectedItem="{Binding SelectedPrototype, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:PrototypeViewModel">
                    <TextBlock Padding="0,5" Text="{Binding Id}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
