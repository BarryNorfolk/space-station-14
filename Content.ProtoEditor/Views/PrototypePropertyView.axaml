<UserControl
    x:Class="Content.ProtoEditor.Views.PrototypePropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Content.ProtoEditor.ViewModels"
    x:DataType="vm:PrototypePropertyViewModel"
    Design.Height="500"
    Design.Width="600">

    <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Margin=" 5">
            <TextBlock.Text>
                <MultiBinding StringFormat=' {0} [{1}]'>
                    <Binding Path="SelectedName" />
                    <Binding Path="SelectedKind" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <Button Margin="5" DockPanel.Dock="Bottom" Command="{Binding SaveChangesCommand}" Content="Save Changes" />
        <ScrollViewer>
            <StackPanel Orientation="Vertical">
                <ItemsControl ItemsSource="{Binding Properties}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="175,35,35,*" Margin="0 1 0 2">
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,8,2,0"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    IsVisible="{Binding !IsArrayElement}"
                                    Text="{Binding UiName}">
                                    <!-- TODO: Make this not show a bubble when the tooltip is empty -->
                                    <ToolTip.Tip>
                                        <ItemsControl ItemsSource="{Binding Tooltip}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ToolTip.Tip>
                                </TextBlock>

                                <PathIcon
                                    Grid.Column="1"
                                    Width="20"
                                    Height="20"
                                    Margin="5,0,5,0"
                                    Data="{StaticResource PropertyFrozen}"
                                    IsVisible="{Binding IsFrozen}"
                                    ToolTip.Tip="This property is frozen and cannot be written to." />

                                <PathIcon
                                    Grid.Column="2"
                                    Width="20"
                                    Height="20"
                                    Margin="5,0,5,0"
                                    Data="{StaticResource PropertyInherited}"
                                    IsVisible="{Binding InheritedFields, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    ToolTip.Tip="{Binding InheritedFields}" />

                                <ContentControl
                                    Grid.Column="3"
                                    Margin="0 0 5 0"
                                    Content="{Binding}"
                                    IsEnabled="{Binding !IsFrozen}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
