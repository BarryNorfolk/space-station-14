<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmp="using:Content.ProtoEditor.ViewModels.Properties"
             x:Class="Content.ProtoEditor.Views.Properties.ArrayPropertyView"
             x:DataType="vmp:ArrayPropertyViewModel">
    <Expander
        Width="300"
        VerticalAlignment="Top"
        HorizontalAlignment="Stretch"
        VerticalContentAlignment="Center"
        Header="{Binding Elements.Count, StringFormat='[{0} Elements]'}"
        HorizontalContentAlignment="Stretch">
        <Grid RowDefinitions="Auto, *">
            <Button HorizontalAlignment="Center" Command="{Binding AddItemCommand}" Content="Add Item" />
            <ItemsControl Grid.Row="1" Margin="0 2" ItemsSource="{Binding Elements}" />
        </Grid>
    </Expander>
</UserControl>
