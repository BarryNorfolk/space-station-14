<UserControl
    x:Class="Content.ProtoEditor.Views.Properties.FloatingPointPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmp="using:Content.ProtoEditor.ViewModels.Properties"
    xmlns:utilities="clr-namespace:Content.ProtoEditor.Views.Utilities"
    x:DataType="vmp:FloatingPointPropertyViewModel">

    <Grid ColumnDefinitions="Auto, *">
        <utilities:RemoveElementButton IsVisible="{Binding IsArrayElement}" />
        <NumericUpDown Grid.Column="1" HorizontalContentAlignment="Center"
                       Value="{Binding StringValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.1" />
    </Grid>
</UserControl>
