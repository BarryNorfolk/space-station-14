<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmp="using:Content.ProtoEditor.ViewModels.Properties"
             x:Class="Content.ProtoEditor.Views.Properties.ColorPropertyView"
             x:DataType="vmp:ColorPropertyViewModel">
    <StackPanel>
        <ContentControl ContentTemplate="{StaticResource RemoveElementButton}" IsVisible="{Binding IsArrayElement}" />
        <ColorPicker Color="{Binding SelectedColor, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
