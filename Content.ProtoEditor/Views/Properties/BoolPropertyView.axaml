<UserControl
    x:Class="Content.ProtoEditor.Views.Properties.BoolPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmp="using:Content.ProtoEditor.ViewModels.Properties"
    x:DataType="vmp:BoolPropertyViewModel">

    <!-- RemoveElementButton should be injected in the main view -->
    <StackPanel>
        <ContentControl ContentTemplate="{StaticResource RemoveElementButton}" IsVisible="{Binding IsArrayElement}" />
        <CheckBox IsChecked="{Binding Value, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
