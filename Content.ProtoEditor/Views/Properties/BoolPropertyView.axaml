<UserControl
    x:Class="Content.ProtoEditor.Views.Properties.BoolPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmp="using:Content.ProtoEditor.ViewModels.Properties"
    x:DataType="vmp:BoolPropertyViewModel">

    <CheckBox IsChecked="{Binding Value, Mode=TwoWay}" />
</UserControl>
