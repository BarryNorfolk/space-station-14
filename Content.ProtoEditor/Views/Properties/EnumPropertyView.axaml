<UserControl
    x:Class="Content.ProtoEditor.Views.Properties.EnumPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmp="using:Content.ProtoEditor.ViewModels.Properties"
    xmlns:utilities="clr-namespace:Content.ProtoEditor.Views.Utilities"
    x:DataType="vmp:EnumPropertyViewModel">

    <Grid ColumnDefinitions="Auto, *">
        <utilities:RemoveElementButton IsVisible="{Binding IsArrayElement}" />
        <ComboBox Grid.Column="1" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Options}"
                  SelectedItem="{Binding Value, Mode=TwoWay}" />
    </Grid>
</UserControl>
