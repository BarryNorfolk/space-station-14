<UserControl
    x:Class="Content.ProtoEditor.Views.Properties.EntProtoIdPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmp="using:Content.ProtoEditor.ViewModels.Properties"
    xmlns:utilities="clr-namespace:Content.ProtoEditor.Views.Utilities"
    x:DataType="vmp:EntProtoIdPropertyViewModel">

    <StackPanel Orientation="Horizontal">
        <utilities:RemoveElementButton Margin="0 0 5 0" IsVisible="{Binding IsArrayElement}" />
        <TextBlock Margin="0 0 5 0" VerticalAlignment="Center"
                   Text="{Binding ProtoId}" />
        <Button
            Command="{Binding SetIdCommand}"
            Content="Set" />
        <Button
            Command="{Binding GotoIdCommand}"
            Content="Goto"
            IsEnabled="{Binding IsValidProtoEnt}" />
    </StackPanel>
</UserControl>
