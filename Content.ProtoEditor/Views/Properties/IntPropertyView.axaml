<UserControl
    x:Class="Content.ProtoEditor.Views.Properties.IntPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmp="using:Content.ProtoEditor.ViewModels.Properties"
    xmlns:utilities="clr-namespace:Content.ProtoEditor.Views.Utilities"
    x:DataType="vmp:IntPropertyViewModel">

    <Grid ColumnDefinitions="Auto, *">
        <utilities:RemoveElementButton IsVisible="{Binding IsArrayElement}" />
        <NumericUpDown Grid.Column="1" FormatString="0" HorizontalContentAlignment="Center"
                       Value="{Binding Value, Mode=TwoWay}" />
    </Grid>
</UserControl>
