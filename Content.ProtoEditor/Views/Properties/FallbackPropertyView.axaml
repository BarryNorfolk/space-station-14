<UserControl
    x:Class="Content.ProtoEditor.Views.Properties.FallbackPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmp="using:Content.ProtoEditor.ViewModels.Properties"
    x:DataType="vmp:FallbackPropertyViewModel">

    <!-- RemoveElementButton should be injected in the main view -->
    <StackPanel>
        <ContentControl ContentTemplate="{StaticResource RemoveElementButton}" IsVisible="{Binding IsArrayElement}" />
        <TextBlock
            Width="200"
            IsEnabled="false"
            Text="{Binding Value}" />
    </StackPanel>
</UserControl>
