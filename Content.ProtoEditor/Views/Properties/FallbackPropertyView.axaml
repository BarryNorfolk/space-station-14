<UserControl
    x:Class="Content.ProtoEditor.Views.Properties.FallbackPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmp="using:Content.ProtoEditor.ViewModels.Properties"
    xmlns:utilities="clr-namespace:Content.ProtoEditor.Views.Utilities"
    x:DataType="vmp:FallbackPropertyViewModel">

    <StackPanel Orientation="Horizontal">
        <utilities:RemoveElementButton IsVisible="{Binding IsArrayElement}" />
        <TextBlock
            Width="200"
            IsEnabled="false"
            Text="{Binding Value}" />
    </StackPanel>
</UserControl>
